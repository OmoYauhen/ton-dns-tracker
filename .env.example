# Postgres connection used by both diesel_cli and the two binaries.
# Port 5433 (not the Postgres default 5432) to avoid colliding with any
# system-wide Postgres already running on your machine. Must match
# services.postgres.port in devenv.nix if you change it.
DATABASE_URL=postgres://ton_dns_tracker@localhost:5433/ton_dns_tracker

# https://toncenter.com/ API key. Free tier = 10 req/s.
TONCENTER_API_KEY=
TONCENTER_BASE_URL=https://toncenter.com/api/v3
TONCENTER_RATE_LIMIT_RPS=10

# indexer binary: the .ton DNS collection NFT contract address (config
# param #4 / "Root DNS address"). Temporary override until
# crates/indexer/src/main.rs resolves this from blockchain config param #4
# instead (see the TODO there). Raw form:
# -1:e56754f83426f69b09267bd876ac97c44821345b7e266bd956a7bfbfb98df35c
DNS_COLLECTION_ADDRESS=Ef_lZ1T4NCb2mwkme9h2rJfESCE0W34ma9lWp7-_uY3zXDvq

# ui binary
BIND_ADDR=127.0.0.1:8080
